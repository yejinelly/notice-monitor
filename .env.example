# Gmail API OAuth client JSON and token paths. Do not commit either file.
# This is the single, operator-managed Notice Monitor sender account.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# The public pilot accepts registrations and sends notices only through this time (KST).
PILOT_END_AT=2026-10-30T23:59:59+09:00

# Shared subscription database. Keep the service-role key secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
